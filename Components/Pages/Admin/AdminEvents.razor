@page "/admin"
@rendermode InteractiveServer
@inject IDbContextFactory<WineTastingDbContext> DbFactory
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Admin · Wine Tasting</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5">Events</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            New event
        </MudButton>
    </MudStack>

    @if (_events is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_events.Count == 0)
    {
        <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="0" Outlined="true">
            <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Class="mb-2" />
            <MudText Typo="Typo.body1" Align="Align.Center">No events yet. Create one to get started.</MudText>
        </MudPaper>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var ev in _events)
            {
                <MudPaper Class="pa-3" Elevation="1" @onclick="() => OpenEvent(ev.Id)" Style="cursor:pointer;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">@ev.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @ev.Date.ToString("dddd, d MMMM yyyy") · @ev.WineCount wines · @ev.ParticipantCount participants
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @if (ev.IsRevealed)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Revealed</MudChip>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" />
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
</MudStack>

@code {
    private List<EventRow>? _events;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _events = await db.Events
            .OrderByDescending(e => e.Date)
            .ThenBy(e => e.Name)
            .Select(e => new EventRow(
                e.Id,
                e.Name,
                e.Date,
                e.IsRevealed,
                e.Wines.Count,
                e.Participants.Count))
            .ToListAsync();
    }

    private async Task OpenCreateDialog()
    {
        var result = await (await DialogService.ShowAsync<EventCreateDialog>("New event")).Result;
        if (result is { Canceled: false, Data: Event newEvent })
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Events.Add(newEvent);
            await db.SaveChangesAsync();
            Snackbar.Add($"Event \"{newEvent.Name}\" created", Severity.Success);
            Nav.NavigateTo($"/admin/events/{newEvent.Id}");
        }
    }

    private void OpenEvent(Guid id) => Nav.NavigateTo($"/admin/events/{id}");

    private record EventRow(Guid Id, string Name, DateOnly Date, bool IsRevealed, int WineCount, int ParticipantCount);
}
