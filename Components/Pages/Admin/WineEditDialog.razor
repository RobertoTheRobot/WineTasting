@inject ImageStorageService ImageStorage
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (Wine.Number > 0)
            {
                <MudText Typo="Typo.caption">Wine #@Wine.Number</MudText>
            }

            <MudSelect T="WineType" @bind-Value="Wine.Type" Label="Type" Variant="Variant.Outlined" Required="true">
                @foreach (var t in Enum.GetValues<WineType>())
                {
                    <MudSelectItem Value="@t">@t</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="Wine.Name"
                          Label="Name"
                          Required="true"
                          MaxLength="200"
                          Variant="Variant.Outlined" />

            <MudTextField @bind-Value="Wine.Origin"
                          Label="Origin"
                          MaxLength="200"
                          Variant="Variant.Outlined" />

            <MudTextField @bind-Value="Wine.Description"
                          Label="Description"
                          Lines="3"
                          MaxLength="2000"
                          Variant="Variant.Outlined" />

            <MudTextField @bind-Value="Wine.Characteristics"
                          Label="Characteristics"
                          Lines="3"
                          MaxLength="2000"
                          Variant="Variant.Outlined"
                          HelperText="Aroma, body, tasting notes — what makes this wine special." />

            <MudStack Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2">Photos</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Up to 2 vertical phone photos (e.g. Pixel 8 portrait, ~3:4) — front and back of the bottle work well.
                    </MudText>
                </MudStack>

                <MudGrid Spacing="2">
                    @for (var i = 1; i <= 2; i++)
                    {
                        var slotIndex = i;
                        var label = $"Photo {slotIndex}";
                        var currentPath = slotIndex == 1 ? Wine.ImagePath : Wine.ImagePath2;
                        var pendingFile = slotIndex == 1 ? _pendingFile1 : _pendingFile2;
                        <MudItem xs="6">
                            <MudPaper Class="pa-2" Elevation="0" Outlined="true" Style="height:100%;">
                                <MudStack Spacing="1" Style="height:100%;">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@label</MudText>

                                    @if (!string.IsNullOrWhiteSpace(currentPath) && pendingFile is null)
                                    {
                                        <div style="position:relative;width:100%;aspect-ratio:3/4;border-radius:8px;overflow:hidden;background:var(--mud-palette-action-default-hover);">
                                            <img src="@currentPath" alt="@label" style="width:100%;height:100%;object-fit:cover;display:block;" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           Variant="Variant.Filled"
                                                           OnClick="@(() => ClearSlot(slotIndex))"
                                                           Style="position:absolute;top:4px;right:4px;background:rgba(255,255,255,0.85);"
                                                           title="Remove photo" />
                                        </div>
                                    }
                                    else if (pendingFile is not null)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true" Class="my-0">
                                            @pendingFile.Name (@FormatBytes(pendingFile.Size))
                                        </MudAlert>
                                    }
                                    else
                                    {
                                        <div style="width:100%;aspect-ratio:3/4;border-radius:8px;border:1px dashed var(--mud-palette-lines-default);display:flex;align-items:center;justify-content:center;color:var(--mud-palette-text-secondary);">
                                            <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Large" />
                                        </div>
                                    }

                                    <MudFileUpload T="IBrowserFile"
                                                   FilesChanged="@(f => OnFileChanged(slotIndex, f))"
                                                   Accept=".jpg,.jpeg,.png,.webp,.gif"
                                                   MaximumFileCount="1">
                                        <CustomContent Context="upload">
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.PhotoCamera"
                                                       FullWidth="true"
                                                       Size="Size.Small"
                                                       OnClick="@upload.OpenFilePickerAsync">
                                                @(string.IsNullOrWhiteSpace(currentPath) && pendingFile is null ? "Choose" : "Replace")
                                            </MudButton>
                                        </CustomContent>
                                    </MudFileUpload>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@(_saving || string.IsNullOrWhiteSpace(Wine.Name))">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Wine Wine { get; set; } = default!;

    private IBrowserFile? _pendingFile1;
    private IBrowserFile? _pendingFile2;
    private bool _clearImage1;
    private bool _clearImage2;
    private bool _saving;

    private string? _originalImage1;
    private string? _originalImage2;

    protected override void OnParametersSet()
    {
        _originalImage1 = Wine.ImagePath;
        _originalImage2 = Wine.ImagePath2;
    }

    private void OnFileChanged(int slotIndex, IBrowserFile? file)
    {
        if (slotIndex == 1)
        {
            _pendingFile1 = file;
            _clearImage1 = false;
        }
        else
        {
            _pendingFile2 = file;
            _clearImage2 = false;
        }
    }

    private void ClearSlot(int slotIndex)
    {
        if (slotIndex == 1)
        {
            _pendingFile1 = null;
            _clearImage1 = true;
            Wine.ImagePath = null;
        }
        else
        {
            _pendingFile2 = null;
            _clearImage2 = true;
            Wine.ImagePath2 = null;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(Wine.Name)) return;
        _saving = true;
        try
        {
            var oldImagesToDelete = new List<string?>();

            if (_pendingFile1 is not null)
            {
                var newPath = await ImageStorage.SaveWineImageAsync(_pendingFile1);
                if (!string.IsNullOrWhiteSpace(_originalImage1)) oldImagesToDelete.Add(_originalImage1);
                Wine.ImagePath = newPath;
            }
            else if (_clearImage1 && !string.IsNullOrWhiteSpace(_originalImage1))
            {
                oldImagesToDelete.Add(_originalImage1);
            }

            if (_pendingFile2 is not null)
            {
                var newPath = await ImageStorage.SaveWineImageAsync(_pendingFile2);
                if (!string.IsNullOrWhiteSpace(_originalImage2)) oldImagesToDelete.Add(_originalImage2);
                Wine.ImagePath2 = newPath;
            }
            else if (_clearImage2 && !string.IsNullOrWhiteSpace(_originalImage2))
            {
                oldImagesToDelete.Add(_originalImage2);
            }

            MudDialog.Close(DialogResult.Ok(new SaveResult(Wine, oldImagesToDelete)));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Image upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.##} MB";
    }

    public record SaveResult(Wine Wine, List<string?> OldImagesToDelete);
}
