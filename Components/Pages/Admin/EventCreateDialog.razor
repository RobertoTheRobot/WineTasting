@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name"
                          Label="Event name"
                          Required="true"
                          MaxLength="200"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudDatePicker @bind-Date="_date"
                           Label="Date"
                           Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(string.IsNullOrWhiteSpace(_name))">
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _name = "";
    private DateTime? _date = DateTime.Today;

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        var ev = new Event
        {
            Name = _name.Trim(),
            Date = DateOnly.FromDateTime(_date ?? DateTime.Today),
        };
        MudDialog.Close(DialogResult.Ok(ev));
    }
}
