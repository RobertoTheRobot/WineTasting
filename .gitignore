# WineTasting runtime data when bind-mounted from compose.yaml
# (SQLite database, uploaded wine images — DO NOT commit).
# Named "runtime-data" (not "data") because Windows git checkouts match
# .gitignore case-insensitively — a literal /data/ rule silently swallowed
# the C# `Data/` source folder (EF models, DbContext) from every commit.
/runtime-data/
/uploads/

# User-uploaded wine photos served by the dev app — runtime data, not source.
wwwroot/uploads/wines/

# Per-deployment compose overrides (Seq URL/api key, image tag…).
.env

# Dev SQLite database before containerization.
/App_Data/

# .NET build artifacts
[Bb]in/
[Oo]bj/

# Build/publish artifacts left in the repo root.
*.log
*.binlog
*.tar.gz

# Publish profiles are user-/host-specific (leak registry URLs, paths, etc).
**/PublishProfiles/*.pubxml
*.pubxml.user

# Visual Studio
.vs/
*.user
*.suo

# Rider / Claude tooling
.idea/
.claude/
